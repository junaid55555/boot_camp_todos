root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120
# Same rules as kotlin.code.style=official (Android Studio's default), not ktlint's stricter house style.
ktlint_code_style = intellij_idea
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout = *, java.**, javax.**, kotlin.**, ^
# Composables are PascalCase by Compose convention.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Off because the codebase deliberately does otherwise: one constructor parameter per line even when it would fit,
# compact when-branches, and brace-less if/else expressions.
ktlint_standard_class-signature = disabled
ktlint_standard_blank-line-between-when-conditions = disabled
ktlint_standard_multiline-if-else = disabled

[*.xml]
indent_size = 4
